# ==============================================================================
# API Local Development Environment Configuration
# ==============================================================================
# WARNING: These are strictly placeholder values for local development.
# DO NOT store real production credentials, AWS keys, or secrets here.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# JWT Authentication Configuration (Local Development)
JWT_SECRET=local-dev-jwt-secret-do-not-use-in-production-32bytes
JWT_EXPIRES_IN=7d

# PostgreSQL Database (Step 5 Docker: user=wierd_user, pass=wierd_password, db=wierd_db, port=5432)
DATABASE_URL=postgresql://wierd_user:wierd_password@127.0.0.1:5432/wierd_db?schema=public

# Redis Cache (Step 5 Docker: port=6380)
REDIS_URL=redis://127.0.0.1:6380
