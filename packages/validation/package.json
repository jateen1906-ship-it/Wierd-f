{
  "name": "@food-evolution/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod runtime validation schemas for the Social Food Evolution Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc --noEmit --skipLibCheck",
    "build": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc --skipLibCheck"
  },
  "dependencies": {
    "@food-evolution/types": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
